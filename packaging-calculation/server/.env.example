# MongoDB Atlas connection string (one database shared by all customers)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/packaging_solution

# Long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me

# Where the React app runs (for CORS and share links)
CLIENT_URL=http://127.0.0.1:5173

PORT=4000
NODE_ENV=development

# Days of free Pro trial for new sign-ups
TRIAL_DAYS=14

# Phase 2: Python CAD service and file storage
CAD_SERVICE_URL=http://127.0.0.1:8000
STORAGE_DIR=./storage
CAD_MAX_MB=50

# Phase 3: background calculations (false = run `npm run worker` separately)
RUN_WORKER=true
WORKER_CONCURRENCY=2
